@import "tailwindcss";

:root {
  --background: #f5f7fb;
  --foreground: #0f172a;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  font-size: 16px;
  line-height: 1.5;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.jobseeker-home-filter-panel .jobseeker-filter-text,
.jobseeker-home-filter-panel .jobseeker-filter-input {
  font-size: 11px !important;
  font-weight: 800 !important;
  line-height: 1 !important;
  letter-spacing: 0 !important;
}

.jobseeker-home-filter-panel .jobseeker-filter-input::placeholder {
  font-size: 12px !important;
  font-weight: 600 !important;
}

/* MediaHire Messages fixed height layout */
.mediahire-messages-fixed {
  height: calc(100dvh - 156px) !important;
  max-height: calc(100dvh - 156px) !important;
  min-height: 0 !important;
  overflow: hidden !important;
  align-items: stretch !important;
}

.mediahire-messages-fixed > * {
  height: 100% !important;
  max-height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

.mediahire-messages-fixed > *:first-child {
  display: flex !important;
  flex-direction: column !important;
}

.mediahire-messages-fixed > *:first-child > *:last-child {
  min-height: 0 !important;
  flex: 1 1 0% !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
}

.mediahire-messages-fixed > *:last-child {
  display: flex !important;
  flex-direction: column !important;
}

.mediahire-messages-fixed > *:last-child > *:first-child {
  flex: 0 0 auto !important;
}

.mediahire-messages-fixed > *:last-child > *:nth-last-child(2) {
  min-height: 0 !important;
  flex: 1 1 0% !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
}

.mediahire-messages-fixed > *:last-child > *:last-child {
  flex: 0 0 auto !important;
}

