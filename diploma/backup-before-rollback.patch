+async function syncStoredProjectsToSupabase(
+  profile: ProfileSummary,
+  storedProjects: MediaHireProject[],
+) {
+  const projectsToSync = storedProjects.filter(
+    (project) =>
+      project.authorId === profile.id &&
+      project.status === "published" &&
+      !isPermanentlyDeletedProjectId(project.id),
+  );
+
+  if (!projectsToSync.length) {
+    return;
+  }
+
+  for (const project of projectsToSync) {
+    try {
+      const coverUrl =
+        project.coverUrl ||
+        project.media?.find((item) => item.type === "image" && item.url)?.url ||
+        project.media?.find((item) => item.url)?.url ||
+        null;
+
+      await supabase.from("projects").upsert({
+        id: project.id,
+        title: project.title,
+        description: project.description || "",
+        status: project.status,
+        cover_url: coverUrl,
+        author_id: profile.id,
+        created_at: project.createdAt || new Date().toISOString(),
+        updated_at: new Date().toISOString(),
+        published_at:
+          project.publishedAt ||
+          project.updatedAt ||
+          project.createdAt ||
+          new Date().toISOString(),
+      });
+
+      await supabase.from("project_media").delete().eq("project_id", project.id);
+
+      const mediaRows = (project.media || [])
+        .map((media, index) => ({
+          id: media.id,
+          project_id: project.id,
+          type: media.type,
+          url: media.url || null,
+          text_content: media.textContent || null,
+          file_name: media.fileName || null,
+          order_index: media.orderIndex ?? index,
+          created_at: project.createdAt || new Date().toISOString(),
+        }))
+        .filter((media) => media.url || media.text_content);
+
+      if (mediaRows.length) {
+        await supabase.from("project_media").upsert(mediaRows);
+      }
+    } catch (error) {
+      console.error("Could not sync stored project to Supabase:", project.title, error);
