      setIsSaving(false);
      setSavingAction(null);
    }
  }

  const fileButtons = [
    { accept: "image/*", icon: ImageIcon, label: "Image file", type: "image" },
    { accept: "application/pdf", icon: FileText, label: "PDF file", type: "pdf" },
