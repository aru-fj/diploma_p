const fallbackCover =
  "data:image/svg+xml;utf8," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="420" viewBox="0 0 1600 420">
      <defs>
        <linearGradient id="g" x1="0" x2="1">
          <stop offset="0" stop-color="#EAF3FF"/>
          <stop offset="1" stop-color="#F8FBFF"/>
        </linearGradient>
      </defs>
      <rect width="1600" height="420" fill="url(#g)"/>
    </svg>`,
  );

const fallbackAvatar =
  "data:image/svg+xml;utf8," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160">
      <rect width="160" height="160" rx="36" fill="#EAF3FF"/>
      <circle cx="80" cy="62" r="28" fill="#0B63E5"/>
      <path d="M34 140c8-30 29-45 46-45s38 15 46 45" fill="#0B63E5"/>
    </svg>`,
  );

function slugify(value?: string | null) {
  return (value || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function splitList(value?: string | string[] | null) {
  if (Array.isArray(value)) return value.filter(Boolean);

  return (value || "")
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);
}

function formatLocation(profile: any) {
  return (
    profile.location ||
    [profile.city, profile.country].filter(Boolean).join(", ") ||
    "Location not added"
  );
}

function formatExperience(value?: string | null) {
  if (!value) return "Experience not added";
  return value.includes("year") ? value : `${value}+ years experience`;
}

function getProjectImage(project: ProfileProject) {
  return (
    project.coverUrl ||
    project.media.find((item) => item.type === "image" && item.url)?.url ||
    project.media.find((item) => item.url)?.url ||
    fallbackCover
  );
}

async function uploadFileToProfileAssets(
  file: File,
  userId: string,
  folder: "cover" | "avatar" | "resume" | "project",
) {
  const extension = file.name.split(".").pop() || "file";
  const safeName = file.name
    .replace(/\.[^/.]+$/, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

  const path = `${userId}/${folder}/${Date.now()}-${safeName}.${extension}`;

  const { error } = await supabase.storage
    .from("profile-assets")
    .upload(path, file, {
      cacheControl: "3600",
      upsert: true,
    });

  if (error) throw error;

  const { data } = supabase.storage.from("profile-assets").getPublicUrl(path);

  return data.publicUrl;
}

async function loadProfile(): Promise<ProfileSummary> {
  const localProfile = getStoredJobSeekerProfile() as any;
  const resume = getResumeData() as any;

  const { data: userData } = await supabase.auth.getUser();
  const user = userData.user;

  const localFullName =
    localProfile.fullName ||
    [localProfile.firstName, localProfile.lastName].filter(Boolean).join(" ");

  if (!user) {
    const fullName = localFullName || "MediaHire creator";

    return {
      id: "",
      userId: "",
      publicSlug: slugify(fullName),
      fullName,
      email: localProfile.email || "",
      avatarUrl: localProfile.avatarPreview || fallbackAvatar,
      coverUrl: localProfile.coverUrl || fallbackCover,
      role: localProfile.jobTitle || localProfile.role || "Role not added",
      location: formatLocation(localProfile),
      experience: formatExperience(localProfile.experienceYears),
      bio: localProfile.bio || resume.about || "",
      skills: splitList(localProfile.skills || resume.skills),
      software: splitList(localProfile.software),
      yearOfBirth: localProfile.yearOfBirth || "",
      gender: localProfile.gender || "",
      mobile: localProfile.mobile || "",
      minimumSalaryAmount:
        localProfile.minimumSalary || localProfile.expectedSalary || "",
      preferredWorkType: localProfile.preferredWorkType || "",
      resumeUrl: localProfile.resumeUrl || resume.pdfUrl || "",
      resumeName: resume.pdfName || "resume.pdf",
    };
  }

  const profileSelect =
    "id,user_id,public_slug,full_name,first_name,last_name,email,avatar_url,cover_url,location,city,country,bio,skills,software,resume_url,resume_name,year_of_birth,gender,mobile,minimum_salary,preferred_work_type";

  const byUserId = await supabase
    .from("profiles")
    .select(profileSelect)
    .eq("user_id", user.id)
    .limit(1);

  const dbProfile = byUserId.data?.[0] as any | undefined;

  const fullName =
    localFullName ||
    dbProfile?.full_name ||
    [dbProfile?.first_name, dbProfile?.last_name].filter(Boolean).join(" ") ||
    user.user_metadata?.full_name ||
    user.email?.split("@")[0] ||
    "MediaHire creator";

  const publicSlug = dbProfile?.public_slug || slugify(fullName);

  return {
    id: dbProfile?.id || user.id,
    userId: user.id,
    publicSlug,
    fullName,
    email: localProfile.email || dbProfile?.email || user.email || "",
    avatarUrl:
      localProfile.avatarPreview ||
      dbProfile?.avatar_url ||
      user.user_metadata?.avatar_url ||
      fallbackAvatar,
    coverUrl: localProfile.coverUrl || dbProfile?.cover_url || fallbackCover,
    role: localProfile.jobTitle || localProfile.role || "Role not added",
    location:
      localProfile.location ||
      formatLocation(dbProfile || {}) ||
      "Location not added",
    experience: formatExperience(localProfile.experienceYears),
    bio: localProfile.bio || dbProfile?.bio || resume.about || "",
    skills: splitList(localProfile.skills || dbProfile?.skills || resume.skills),
    software: splitList(localProfile.software || dbProfile?.software),
    yearOfBirth: localProfile.yearOfBirth || dbProfile?.year_of_birth || "",
    gender: localProfile.gender || dbProfile?.gender || "",
    mobile: localProfile.mobile || dbProfile?.mobile || "",
    minimumSalaryAmount:
      localProfile.minimumSalary ||
      localProfile.expectedSalary ||
      dbProfile?.minimum_salary ||
      "",
    preferredWorkType:
      localProfile.preferredWorkType || dbProfile?.preferred_work_type || "",
    resumeUrl: localProfile.resumeUrl || dbProfile?.resume_url || resume.pdfUrl || "",
    resumeName: dbProfile?.resume_name || resume.pdfName || "resume.pdf",
  };
}

async function saveProfileToSupabase(profile: ProfileSummary) {
  if (!profile.userId) return;

  const payload = {
    user_id: profile.userId,
    public_slug: slugify(profile.fullName),
    full_name: profile.fullName,
    email: profile.email,
    avatar_url: profile.avatarUrl && profile.avatarUrl !== fallbackAvatar ? profile.avatarUrl : null,
    cover_url: profile.coverUrl && profile.coverUrl !== fallbackCover ? profile.coverUrl : null,
    location: profile.location,
    bio: profile.bio,
    skills: profile.skills,
    software: profile.software,
    resume_url: profile.resumeUrl || null,
    resume_name: profile.resumeName || null,
    year_of_birth: profile.yearOfBirth || null,
    gender: profile.gender || null,
    mobile: profile.mobile || null,
    minimum_salary: profile.minimumSalaryAmount || null,
    preferred_work_type: profile.preferredWorkType || null,
    updated_at: new Date().toISOString(),
  };

  const existing = await supabase
    .from("profiles")
    .select("id,user_id")
    .eq("user_id", profile.userId)
    .limit(1);

  if (existing.data?.[0]) {
    await supabase
      .from("profiles")
      .update(payload)
      .eq("user_id", profile.userId);
  } else {
    await supabase.from("profiles").insert({
      ...payload,
      role: "jobseeker",
      created_at: new Date().toISOString(),
    });
  }
}

async function loadProjects(profile: ProfileSummary): Promise<ProfileProject[]> {
  if (!profile.userId) return [];

  const { data: rows, error } = await supabase
    .from("projects")
    .select("id,title,description,status,cover_url,created_at,updated_at,published_at,author_id")
    .eq("author_id", profile.userId)
    .order("updated_at", { ascending: false });

  if (error || !rows?.length) return [];

  const projectIds = rows.map((item: any) => item.id).filter(Boolean);

  const { data: mediaRows } = projectIds.length
    ? await supabase
        .from("project_media")
        .select("id,project_id,type,url,text_content,file_name,order_index")
        .in("project_id", projectIds)
        .order("order_index", { ascending: true })
    : { data: [] };

  return rows.map((row: any) => ({
    id: row.id,
    title: row.title || "Untitled project",
    description: row.description || "",
    status: row.status || "draft",
    coverUrl: row.cover_url || "",
    createdAt: row.created_at || new Date().toISOString(),
    updatedAt: row.updated_at || row.created_at || new Date().toISOString(),
    publishedAt: row.published_at,
    media: ((mediaRows || []) as any[])
      .filter((media) => media.project_id === row.id)
      .map((media) => ({
        id: media.id,
        type: media.type,
        url: media.url,
        text_content: media.text_content,
        file_name: media.file_name,
        order_index: media.order_index,
      })),
  }));
}

