  const [isLoading, setIsLoading] = useState(true);
  const [notice, setNotice] = useState("");

  const resume = useMemo(() => getResumeData() as any, [profile]);

  useEffect(() => {
    let isMounted = true;

    async function hydrate() {
      setIsLoading(true);

      const loadedProfile = await loadProfile();
      const loadedProjects = await loadProjects(loadedProfile);

      if (!isMounted) return;

      setProfile(loadedProfile);
      setProjects(loadedProjects);
      setIsLoading(false);
    }

    void hydrate();

    function sync() {
      void hydrate();
    }

    window.addEventListener("mediahire:jobseeker-profile-updated", sync);
    window.addEventListener("mediahire:projects-updated", sync);
    window.addEventListener("storage", sync);

    return () => {
      isMounted = false;
      window.removeEventListener("mediahire:jobseeker-profile-updated", sync);
      window.removeEventListener("mediahire:projects-updated", sync);
      window.removeEventListener("storage", sync);
    };
  }, []);

  async function handleCoverChange(event: ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    event.target.value = "";

    if (!file || !profile) return;

    try {
      setNotice("Uploading background...");
      const publicUrl = await uploadFileToProfileAssets(file, profile.userId, "cover");

      const nextProfile = {
        ...profile,
        coverUrl: publicUrl,
      };

      setProfile(nextProfile);
      await saveProfileToSupabase(nextProfile);

      const storedProfile = getStoredJobSeekerProfile() as any;
      saveJobSeekerProfile({
        ...storedProfile,
        fullName: nextProfile.fullName,
        email: nextProfile.email,
        avatarPreview: nextProfile.avatarUrl,
        coverUrl: publicUrl,
        jobTitle: nextProfile.role,
        role: nextProfile.role,
        location: nextProfile.location,
        skills: nextProfile.skills.join(", "),
        software: nextProfile.software.join(", "),
        bio: nextProfile.bio,
        resumeUrl: nextProfile.resumeUrl,
      } as any);

      window.dispatchEvent(new Event("mediahire:jobseeker-profile-updated"));
      setNotice("Background saved.");
    } catch (error) {
      console.error(error);
      setNotice("Could not upload background.");
    }
  }

  if (isLoading || !profile) {
    return (
