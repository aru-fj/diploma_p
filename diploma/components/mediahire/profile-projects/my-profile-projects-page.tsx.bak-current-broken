              </ResumeCard>

              <ResumeCard icon={<GraduationCap />} title="Education">
                <p className="whitespace-pre-line text-xs font-medium leading-5 text-slate-700">
                  {resume.education || "Not specified"}
                </p>
              </ResumeCard>

              <ResumeCard icon={<Link2 />} title="Links">
                <p className="whitespace-pre-line text-xs font-medium leading-5 text-slate-700">
                  {resume.links || "Not specified"}
                </p>
              </ResumeCard>

              <ResumeCard icon={<Languages />} title="Languages">
                <p className="whitespace-pre-line text-xs font-medium leading-5 text-slate-700">
                  {resume.languages || "Not specified"}
                </p>
              </ResumeCard>

              <ResumeCard icon={<BriefcaseBusiness />} title="Job Preferences">
                <p className="whitespace-pre-line text-xs font-medium leading-5 text-slate-700">
                  {resume.jobPreferences || profile.preferredWorkType || "Not specified"}
                </p>
              </ResumeCard>

              <ResumeCard icon={<FileText />} title="Preferred Job Benefits">
                <p className="whitespace-pre-line text-xs font-medium leading-5 text-slate-700">
                  {resume.benefits || "Not specified"}
                </p>
              </ResumeCard>
            </div>
          ) : null}

          {activeTab === "reviews" ? (
            <div className="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
              <h3 className="text-xl font-black text-slate-950">
                No reviews yet
              </h3>
              <p className="mx-auto mt-3 max-w-md text-sm font-semibold leading-6 text-slate-500">
                Reviews from employers will appear here after completed work.
              </p>
            </div>
          ) : null}
        </section>
      </section>
    </main>
  );
}
