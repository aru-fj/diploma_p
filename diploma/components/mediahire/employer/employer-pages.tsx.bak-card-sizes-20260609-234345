function splitEmployerProfileList(value?: string[] | string | null) {
  if (Array.isArray(value)) {
    return value.filter(Boolean);
  }

  return (value || "")
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);
}

function toEmployerCandidateFromProfile(profile: {
  avatar_url?: string | null;
  bio?: string | null;
  city?: string | null;
  country?: string | null;
  cover_url?: string | null;
  email?: string | null;
  experience_years?: string | number | null;
  first_name?: string | null;
  full_name?: string | null;
  id?: string | null;
  job_title?: string | null;
  last_name?: string | null;
  location?: string | null;
  preferred_work_type?: string | null;
  profession?: string | null;
  public_slug?: string | null;
  resume_name?: string | null;
  resume_url?: string | null;
  skills?: string[] | string | null;
  software?: string[] | string | null;
  user_id?: string | null;
}) {
  const name =
    profile.full_name ||
    [profile.first_name, profile.last_name].filter(Boolean).join(" ") ||
    profile.email?.split("@")[0] ||
    "MediaHire creator";

  const id =
    profile.public_slug ||
    profile.user_id ||
    profile.id ||
    name.toLowerCase().replace(/[^a-z0-9]+/g, "-");

  const role = profile.profession || profile.job_title || "Role not added";
  const skills = splitEmployerProfileList(profile.skills);
  const software = splitEmployerProfileList(profile.software);
  const location =
    profile.location ||
    [profile.city, profile.country].filter(Boolean).join(", ") ||
    "Kazakhstan";
  const experience = profile.experience_years
    ? `${profile.experience_years} years`
    : "Experience not added";

  return {
    avatar: profile.avatar_url || employerPlaceholderAvatar,
    bio: profile.bio || "No bio added yet.",
    category: role,
    city: profile.city || location,
    education: "Not specified",
    email: profile.email || "",
    experience,
    id,
    languages: ["Kazakh", "Russian", "English"],
    location,
    name,
    portfolio: profile.cover_url
      ? [
          {
            authorAvatar: profile.avatar_url || employerPlaceholderAvatar,
            authorId: id,
            authorName: name,
            category: role,
            description: profile.bio || "No portfolio description added yet.",
            id: `${id}-cover`,
            image: profile.cover_url,
            title: `${name} portfolio`,
          },
        ]
      : [
          {
            authorAvatar: profile.avatar_url || employerPlaceholderAvatar,
            authorId: id,
            authorName: name,
            category: role,
            description: profile.bio || "No portfolio description added yet.",
            id: `${id}-cover`,
            image: employerLightBlueCover,
            title: `${name} portfolio`,
          },
        ],
    rating: 0,
    reviews: [],
    role,
    resume: {
      about: profile.bio || "No bio added yet.",
      education: "Not specified",
      experience,
      jobPreferences:
        profile.preferred_work_type || "Available for opportunities",
      languages: "Not specified",
      links: "Not specified",
      skills: skills.join(", "),
    },
    skills,
    software,
  } as EmployerCandidate;
}

async function loadVisibleEmployerCandidates() {
  const { data, error } = await supabase
    .from("profiles")
    .select(
      "id,user_id,public_slug,full_name,first_name,last_name,email,avatar_url,cover_url,profession,job_title,location,city,country,bio,skills,software,preferred_work_type,experience_years,resume_url,resume_name",
    )
    .eq("role", "jobseeker")
    .eq("profile_visibility", true);

  if (error) {
    console.error("Could not load visible employer candidates:", error);
    return [];
  }

  return (data || []).map((profile) => toEmployerCandidateFromProfile(profile));
}

function mergeEmployerCandidates(remoteCandidates: EmployerCandidate[]) {
  const candidatesById = new Map<string, EmployerCandidate>();

  [...employerCandidates, ...remoteCandidates].forEach((candidate) => {
    candidatesById.set(candidate.id, candidate);
  });

  return Array.from(candidatesById.values());
}

function cardMotion(index = 0) {
  return {
    animate: { opacity: 1, y: 0 },
    initial: { opacity: 0, y: 18 },
    transition: { delay: index * 0.035, duration: 0.35 },
  };
}

function useEmployerRefresh() {
  const [version, setVersion] = useState(0);

  useEffect(() => {
    const sync = () => setVersion((current) => current + 1);
    window.addEventListener("mediahire:employer-updated", sync);
    window.addEventListener("storage", sync);
    return () => {
      window.removeEventListener("mediahire:employer-updated", sync);
      window.removeEventListener("storage", sync);
    };
  }, []);

  return version;
}

