}

export function EmployerHomePage() {
  const router = useRouter();
  const version = useEmployerRefresh();
  const [tab, setTab] = useState<Tab>("projects");
  const [query, setQuery] = useState("");
  const [city] = useState("");
  const [category, setCategory] = useState("For You");
  const [activeSort, setActiveSort] =
    useState<EmployerSortOption>("Recommended");
  const [isFilterOpen, setIsFilterOpen] = useState(false);
  const savedProjects = useMemo(() => getSavedProjects(), [version]);
  const savedCandidates = useMemo(() => getSavedCandidates(), [version]);
  const [remoteCandidates, setRemoteCandidates] = useState<EmployerCandidate[]>([]);
  const allCandidates = useMemo(
    () => mergeEmployerCandidates(remoteCandidates),
    [remoteCandidates],
  );
  const mode = toDashboardMode(tab);

  useEffect(() => {
    let isMounted = true;

    loadVisibleEmployerCandidates().then((items) => {
      if (isMounted) {
        setRemoteCandidates(items);
      }
    });

    return () => {
      isMounted = false;
    };
  }, [version]);
  const projects = sortEmployerProjects(
    filterProjects(query, category, savedProjects),
    activeSort,
  );
  const candidates = sortEmployerCandidates(
    filterCandidatesFromList(allCandidates, query, city, category, savedCandidates),
    activeSort,
  );

  function handleModeChange(nextMode: DashboardMode) {
    setTab(toEmployerTab(nextMode));
    setActiveSort("Recommended");
    setQuery("");
  }

  return (
    <EmployerShell active="Home">
      <section className="jobseeker-home-filter-panel mx-auto mt-8 w-[min(1320px,calc(100%-32px))] rounded-[1.25rem] border border-slate-100 bg-white p-3 shadow-[0_14px_45px_rgba(15,23,42,0.06)] md:p-3.5">
        <SearchFilterBar
          mode={mode}
          onModeChange={handleModeChange}
          onOpenFilter={() => setIsFilterOpen((current) => !current)}
          onSearchChange={setQuery}
          search={query}
        />

        {isFilterOpen ? (
          <EmployerSortPills
            activeSort={activeSort}
            mode={mode}
            onSortChange={setActiveSort}
          />
        ) : null}

        <EmployerCategoryPills
          activeCategory={category}
          onChange={setCategory}
        />
      </section>
      <section className="mx-auto mt-8 w-[min(1320px,calc(100%-32px))] pb-20">
        <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-4">
          {tab === "projects"
            ? projects.map((project, index) => (
                <motion.div key={project.id} {...cardMotion(index)}>
                  <ProjectCard onSave={() => toggleSavedProject(project.id)} project={project} saved={savedProjects.includes(project.id)} />
                </motion.div>
              ))
            : candidates.map((candidate, index) => (
                <motion.div key={candidate.id} {...cardMotion(index)}>
                  <CandidateCard candidate={candidate} onMessage={() => openChat(router, candidate.id)} onSave={() => toggleSavedCandidate(candidate.id)} saved={savedCandidates.includes(candidate.id)} />
                </motion.div>
              ))}
        </div>
        {(tab === "projects" && projects.length === 0) || (tab === "people" && candidates.length === 0) ? (
          <div className="mt-8"><EmptyState text="Nothing matches these filters yet." /></div>
        ) : null}
      </section>
    </EmployerShell>
  );
}

export function EmployerProjectDetailPage({ slug }: { slug: string }) {
  const router = useRouter();
  const version = useEmployerRefresh();
  const [comment, setComment] = useState("");
  const [comments, setComments] = useState<EmployerDetailComment[]>([]);
  const [commentAuthor, setCommentAuthor] = useState(() => ({
    avatar: "",
    name: "Employer",
  }));
  const [hasMounted, setHasMounted] = useState(false);
  const [savedTick, setSavedTick] = useState(0);

  const project = employerProjects.find((item) => item.id === slug);

  const savedProjects = useMemo(
    () => (hasMounted ? getSavedProjects() : []),
    [hasMounted, version, savedTick],
  );

  useEffect(() => {
    setHasMounted(true);

    const syncCommentsAndAuthor = () => {
      const nextAuthor = getEmployerCommentAuthor();

      setCommentAuthor(nextAuthor);

      if (!project) return;

      const nextComments = readEmployerProjectDetailComments(
        project.id,
        nextAuthor,
      );

      setComments(nextComments);
      saveEmployerProjectDetailComments(project.id, nextComments);
    };

    syncCommentsAndAuthor();

    window.addEventListener("mediahire:employer-updated", syncCommentsAndAuthor);
    window.addEventListener("storage", syncCommentsAndAuthor);

    return () => {
      window.removeEventListener(
        "mediahire:employer-updated",
        syncCommentsAndAuthor,
      );
      window.removeEventListener("storage", syncCommentsAndAuthor);
    };
  }, [project, version]);

  if (!project) {
    return (
      <EmployerShell active="Home">
        <section className="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 text-center">
          <div className="mb-5 flex h-16 w-16 items-center justify-center rounded-3xl bg-blue-50 text-blue-600">
            <BriefcaseBusiness className="h-8 w-8" />
          </div>

          <h1 className="text-4xl font-black tracking-tight">
            Project not found
          </h1>

          <p className="mt-4 max-w-xl text-base font-medium leading-7 text-slate-500">
            This project does not exist or may have been removed.
          </p>

          <Link
            href="/home/employer"
            className="mt-8 inline-flex h-12 items-center justify-center rounded-2xl bg-blue-600 px-6 text-sm font-black text-white transition hover:bg-blue-700"
          >
            <ArrowLeft className="mr-2 h-4 w-4" />
            Back to home
          </Link>
        </section>
      </EmployerShell>
    );
  }

  const currentProject = project;
  const isSavedProject = hasMounted && savedProjects.includes(currentProject.id);
  const mediaItems = currentProject.media || [{ type: "image", url: currentProject.image }];

  function handleToggleSavedProject() {
    toggleSavedProject(currentProject.id);
    setSavedTick((current) => current + 1);
  }

  function postComment() {
    const value = comment.trim();

    if (!value) return;

    const nextComment: EmployerDetailComment = {
      id: `employer-comment-${Date.now()}`,
      name: commentAuthor.name,
      avatar: commentAuthor.avatar,
      date: formatEmployerCommentDate(),
      isCurrentUser: true,
      text: value,
    };

    const nextComments = [nextComment, ...comments];

    saveProjectComment(currentProject.id, value);
