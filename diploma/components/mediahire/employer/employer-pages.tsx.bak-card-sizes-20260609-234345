export function EmployerSearchCvPage() {
  const router = useRouter();
  const version = useEmployerRefresh();
  const [query, setQuery] = useState("");
  const [location, setLocation] = useState("All Kazakhstan");
  const [category, setCategory] = useState("All");
  const saved = useMemo(() => getSavedCandidates(), [version]);
  const [remoteCandidates, setRemoteCandidates] = useState<EmployerCandidate[]>([]);
  const allCandidates = useMemo(
    () => mergeEmployerCandidates(remoteCandidates),
    [remoteCandidates],
  );

  useEffect(() => {
    let isMounted = true;

    loadVisibleEmployerCandidates().then((items) => {
      if (isMounted) {
        setRemoteCandidates(items);
      }
    });

    return () => {
      isMounted = false;
    };
  }, [version]);

  const candidates = useMemo(() => {
    const normalizedQuery = query.trim().toLowerCase();

    return allCandidates.filter((candidate) => {
      const text = [
        candidate.name,
        candidate.role,
        candidate.category,
        candidate.location,
        candidate.bio,
        candidate.resume.about,
        ...candidate.skills,
      ]
        .join(" ")
        .toLowerCase();

      const matchesQuery = normalizedQuery
        ? text.includes(normalizedQuery)
        : true;

      const matchesLocation =
        location === "All Kazakhstan"
          ? true
          : candidate.location === location || candidate.city === location;

      const matchesCategory = matchesEmployerSearchCvCategory(
        candidate,
        category,
      );

      return matchesQuery && matchesLocation && matchesCategory;
    });
  }, [allCandidates, category, location, query]);

  function handleSearch() {
    const params = new URLSearchParams();

    if (query.trim()) {
      params.set("query", query.trim());
    }

    if (location !== "All Kazakhstan") {
      params.set("location", location);
    }

    window.history.replaceState(
      null,
      "",
      params.toString()
        ? `/home/employer/search-cv?${params.toString()}`
        : "/home/employer/search-cv",
    );
  }

  return (
    <EmployerShell active="Search CV">
      <main className="min-h-screen bg-[#f5f7fb] text-slate-950">
        <div className="bg-[#eaf3ff]">
          <section className="mx-auto w-full max-w-6xl px-4 pb-10 pt-10 text-center sm:px-6 lg:px-10">
            <h1 className="mx-auto max-w-3xl text-3xl font-black tracking-tight text-slate-950 md:text-4xl">
              Want to hire a creative professional?
            </h1>

            <p className="mx-auto mt-3 max-w-2xl text-sm font-semibold text-slate-600 md:text-base">
              You are in the right place. Tell us who and where you are looking
              for — we will show the candidates.
            </p>

            <div className="mx-auto mt-6 flex max-w-3xl flex-col gap-2 rounded-2xl bg-white p-2 shadow-[0_16px_50px_rgba(15,23,42,0.08)] md:flex-row">
              <div className="flex h-10 flex-1 items-center gap-2 rounded-xl bg-slate-50 px-3">
                <Search className="h-4 w-4 text-slate-400" />

                <input
                  value={query}
                  onChange={(event) => setQuery(event.target.value)}
                  onKeyDown={(event) => {
                    if (event.key === "Enter") {
                      handleSearch();
                    }
                  }}
                  list="employer-search-cv-suggestions"
                  placeholder="Profession and position"
                  className="h-full min-w-0 flex-1 bg-transparent text-xs font-bold text-slate-900 outline-none placeholder:text-slate-400"
                />

                <datalist id="employer-search-cv-suggestions">
                  {[
                    "Graphic Designer",
                    "Photographer",
                    "Videographer",
                    "Animator",
                    "3D Artist",
                    "Screenwriter",
