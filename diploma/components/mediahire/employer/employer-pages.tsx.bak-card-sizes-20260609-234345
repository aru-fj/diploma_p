export function EmployerAccountSettingsPage() {
  const [profile, setProfile] = useState<EmployerProfile>(defaultEmployerProfile);
  const [saved, setSaved] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    const sync = () => {
      if (typeof window !== "undefined") {
        const badAvatarPattern =
          /https:\/\/images\.unsplash\.com\/photo-1560250097-0b93528c311a[^"\\]*/g;

        Object.keys(window.localStorage).forEach((key) => {
          const value = window.localStorage.getItem(key);

          if (value && value.includes("photo-1560250097-0b93528c311a")) {
            window.localStorage.setItem(key, value.replace(badAvatarPattern, ""));
          }
        });
      }

      setProfile(getEmployerProfile());
    };
    sync();
    window.addEventListener("mediahire:employer-updated", sync);
    window.addEventListener("storage", sync);
    return () => {
      window.removeEventListener("mediahire:employer-updated", sync);
      window.removeEventListener("storage", sync);
    };
  }, []);

  function update<K extends keyof EmployerProfile>(key: K, value: EmployerProfile[K]) {
    setSaved(false);
    setProfile((current) => ({ ...current, [key]: value }));
  }

  function upload(file?: File) {
    if (!file) return;
    if (!["image/png", "image/jpeg", "image/jpg"].includes(file.type) || file.size > 10 * 1024 * 1024) {
      setError("Use PNG or JPEG under 10MB.");
      return;
    }
    const reader = new FileReader();
    reader.onload = () => update("avatar", String(reader.result));
    reader.readAsDataURL(file);
  }

  function save() {
    if (!profile.firstName || !profile.lastName || !profile.email || !profile.companyDescription) {
      setError("Please fill required fields.");
      return;
    }
    saveEmployerProfile(profile);
    setSaved(true);
    setError("");
  }

  return (
    <EmployerDashboardShell
      active="Account Setting"
      subtitle="Update your company and account settings."
      title="Account Setting"
    >
      <div className="max-w-[900px] rounded-[24px] bg-white p-5 shadow-sm md:p-6">
        <div className="flex flex-col gap-4 border-b border-slate-100 pb-6 md:flex-row md:items-center">
          <label className="grid h-20 w-20 shrink-0 cursor-pointer place-items-center overflow-hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50">
            {profile.avatar ? (
              <Image
                alt={profile.companyName || "Employer"}
                className="h-full w-full object-cover"
                height={96}
                src={profile.avatar}
                unoptimized={profile.avatar.startsWith("data:")}
                width={96}
              />
            ) : (
              <ImageIcon className="text-slate-400" />
            )}
            <input className="hidden" onChange={(event) => upload(event.target.files?.[0])} type="file" />
          </label>

          <div>
            <h2 className="text-lg font-black text-[#0B63E5]">Profile Picture</h2>
            <p className="mt-1 text-xs font-semibold text-slate-500">
              We support PNGs and JPEGs under 10MB
            </p>
            <div className="mt-3 flex gap-3">
              <label className="inline-flex h-10 cursor-pointer items-center rounded-xl bg-[#0B63E5] px-4 text-xs font-black text-white">
                Upload Picture
                <input className="hidden" onChange={(event) => upload(event.target.files?.[0])} type="file" />
              </label>
              <OutlineButton onClick={() => update("avatar", defaultEmployerProfile.avatar)}>
                Remove
              </OutlineButton>
            </div>
          </div>
        </div>

        <div className="mt-6 grid gap-4 md:grid-cols-2">
          <Input label="First Name*" onChange={(value) => update("firstName", value)} value={profile.firstName} />
          <Input label="Last Name*" onChange={(value) => update("lastName", value)} value={profile.lastName} />
          <Input label="Role" onChange={(value) => update("role", value)} value={profile.role} />
          <Input label="Company Name" onChange={(value) => update("companyName", value)} value={profile.companyName} />
          <Input label="Email*" onChange={(value) => update("email", value)} value={profile.email} />
          <Input label="Company Field" onChange={(value) => update("companyField", value)} value={profile.companyField} />

          <label className="md:col-span-2">
            <span className="text-sm font-black">Company Description*</span>
            <textarea
              className="mt-2 min-h-28 w-full resize-none rounded-2xl border border-slate-200 p-4 text-sm font-semibold outline-none focus:border-[#0B63E5]"
              maxLength={512}
              onChange={(event) => update("companyDescription", event.target.value)}
              value={profile.companyDescription}
            />
            <span className="mt-1 block text-right text-xs font-bold text-slate-400">
              {profile.companyDescription.length}/512
            </span>
          </label>
        </div>

        <div className="mt-6 flex flex-wrap items-center gap-3">
          <OutlineButton onClick={() => setProfile(getEmployerProfile())}>Cancel</OutlineButton>
          <PrimaryButton onClick={save}>Save</PrimaryButton>

          {error ? (
            <span className="inline-flex min-h-10 items-center rounded-xl border border-[#0B63E5]/10 bg-[#eef4ff] px-4 text-xs font-black text-[#0B63E5]">
              {error}
            </span>
          ) : null}

          {saved ? (
            <span className="inline-flex min-h-10 items-center rounded-xl border border-[#0B63E5]/10 bg-[#eef4ff] px-4 text-xs font-black text-[#0B63E5]">
              Saved successfully.
            </span>
          ) : null}
        </div>
      </div>
    </EmployerDashboardShell>
  );
}


export function EmployerSettingsPage() {
  const [settings, setSettings] = useState<EmployerSettings>(() => getEmployerSettings());
  const [password, setPassword] = useState({ confirm: "", next: "" });
  const [message, setMessage] = useState("");

  function update<K extends keyof EmployerSettings>(key: K, value: EmployerSettings[K]) {
    setSettings((current) => ({ ...current, [key]: value }));
  }

  function save() {
    if ((password.next || password.confirm) && password.next !== password.confirm) {
      setMessage("Passwords must match");
      return;
    }
    saveEmployerSettings(settings);
    setMessage("Settings saved.");
  }

  return (
    <EmployerDashboardShell
      active="Settings"
      subtitle="Manage employer notifications, privacy, integrations, and security."
      title="Settings"
    >
      <div className="max-w-[900px] rounded-[24px] bg-white p-5 shadow-sm md:p-6">
        <div className="grid gap-4 md:grid-cols-2">
          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("messages", !settings.messages)}
            type="button"
          >
            <span>Messages</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.messages ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.messages ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("interviewUpdates", !settings.interviewUpdates)}
            type="button"
          >
            <span>Interview Updates</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.interviewUpdates ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.interviewUpdates ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("newApplications", !settings.newApplications)}
            type="button"
          >
            <span>New Applications</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.newApplications ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.newApplications ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("companyVisibility", !settings.companyVisibility)}
            type="button"
          >
            <span>Company Visibility</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.companyVisibility ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.companyVisibility ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("publicJobPosts", !settings.publicJobPosts)}
            type="button"
          >
            <span>Public Job Posts</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.publicJobPosts ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.publicJobPosts ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <button
            className="flex h-[54px] items-center justify-between rounded-2xl bg-slate-50 px-4 text-sm font-black text-slate-800 transition hover:bg-slate-100"
            onClick={() => update("googleIntegration", !settings.googleIntegration)}
            type="button"
          >
            <span>Google integration</span>
            <span className={`relative h-6 w-10 rounded-full transition ${settings.googleIntegration ? "bg-[#0B63E5]" : "bg-slate-300"}`}>
              <span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${settings.googleIntegration ? "left-5" : "left-1"}`} />
            </span>
          </button>

          <label className="block">
            <span className="text-sm font-black text-slate-700">Language</span>
            <select
              className="mt-2 h-10 w-full rounded-2xl border border-slate-200 bg-white px-4 text-sm font-semibold outline-none focus:border-[#0B63E5]"
              onChange={(event) => update("language", event.target.value)}
              value={settings.language}
            >
              {["English", "Kazakh", "Russian"].map((option) => (
                <option key={option}>{option}</option>
              ))}
            </select>
          </label>

          <label className="block">
            <span className="text-sm font-black text-slate-700">Theme</span>
            <select
              className="mt-2 h-10 w-full rounded-2xl border border-slate-200 bg-white px-4 text-sm font-semibold outline-none focus:border-[#0B63E5]"
              onChange={(event) => update("theme", event.target.value)}
              value={settings.theme}
            >
              {["Light", "Dark", "System"].map((option) => (
                <option key={option}>{option}</option>
              ))}
            </select>
          </label>

          <Input
            label="New Password"
            onChange={(value) => setPassword((current) => ({ ...current, next: value }))}
            value={password.next}
          />

          <Input
            label="Confirm Password"
            onChange={(value) => setPassword((current) => ({ ...current, confirm: value }))}
            value={password.confirm}
          />
        </div>

        <div className="mt-6 flex flex-wrap items-center gap-3">
          <OutlineButton onClick={() => setSettings(getEmployerSettings())}>Cancel</OutlineButton>
          <PrimaryButton onClick={save}>Save</PrimaryButton>
          {message ? (
            <span className="inline-flex min-h-10 items-center rounded-xl border border-[#0B63E5]/10 bg-[#eef4ff] px-4 text-xs font-black text-[#0B63E5]">
              {message}
            </span>
          ) : null}
        </div>
      </div>
    </EmployerDashboardShell>
  );
}


function SettingsSection({ children, title }: { children: React.ReactNode; title: string }) {
  return <section className="rounded-2xl border border-slate-200 p-3.5"><h2 className="text-base font-black">{title}</h2><div className="mt-3 grid gap-3 md:grid-cols-2">{children}</div></section>;
}

function Toggle({ checked, label, onChange }: { checked: boolean; label: string; onChange: (value: boolean) => void }) {
  return <button className="flex items-center justify-between rounded-xl bg-slate-50 p-3 text-xs font-black" onClick={() => onChange(!checked)} type="button"><span>{label}</span><span className={`relative h-6 w-9 rounded-full transition ${checked ? "bg-[#0B63E5]" : "bg-slate-300"}`}><span className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${checked ? "left-5" : "left-1"}`} /></span></button>;
}

function Select({ label, onChange, options, value }: { label: string; onChange: (value: string) => void; options: string[]; value: string }) {
  return <label className="block"><span className="text-sm font-black">{label}</span><select className="mt-2 h-9 w-full rounded-xl border border-slate-200 px-3 text-xs font-semibold outline-none focus:border-[#0B63E5]" onChange={(event) => onChange(event.target.value)} value={value}>{options.map((option) => <option key={option}>{option}</option>)}</select></label>;
}
