type EmployerSortOption = "Recommended" | "Top Rated" | "Popular Now" | "Most Viewed" | "Most Discussed" | "Recently Added";

const employerProjectSortOptions: EmployerSortOption[] = [
  "Recommended",
  "Top Rated",
  "Popular Now",
  "Most Viewed",
  "Most Discussed",
  "Recently Added",
];

const employerPeopleSortOptions: EmployerSortOption[] = [
  "Recommended",
  "Top Rated",
  "Popular Now",
  "Most Viewed",
  "Most Discussed",
  "Recently Added",
];

function toDashboardMode(tab: Tab): DashboardMode {
  return tab === "people" ? "People" : "Projects";
}

function toEmployerTab(mode: DashboardMode): Tab {
  return mode === "People" ? "people" : "projects";
}

function sortEmployerProjects(projects: EmployerProject[], sort: EmployerSortOption) {
  const sorted = [...projects];

  if (sort === "Recently Added") {
    return sorted.reverse();
  }

  if (sort === "Top Rated" || sort === "Popular Now" || sort === "Most Viewed" || sort === "Most Discussed") {
    return sorted;
  }

  return sorted;
}

function sortEmployerCandidates(candidates: EmployerCandidate[], sort: EmployerSortOption) {
  const sorted = [...candidates];

  if (sort === "Recently Added") {
    return sorted.reverse();
  }

  if (sort === "Top Rated") {
    return sorted.sort((a, b) => (b.rating || 0) - (a.rating || 0));
  }

  if (sort === "Popular Now" || sort === "Most Viewed" || sort === "Most Discussed") {
    return sorted;
  }

  return sorted;
}

function EmployerSortPills({
  activeSort,
  mode,
  onSortChange,
}: {
  activeSort: EmployerSortOption;
  mode: DashboardMode;
  onSortChange: (sort: EmployerSortOption) => void;
}) {
  const sortOptions =
    mode === "People" ? employerPeopleSortOptions : employerProjectSortOptions;

  return (
    <div className="mt-2.5 flex flex-wrap justify-center gap-1.5 rounded-2xl bg-slate-50 p-2">
      {sortOptions.map((option) => {
        const isActive = activeSort === option;

        return (
          <button
            key={option}
            type="button"
            onClick={() => onSortChange(option)}
            className={`jobseeker-filter-text h-7 rounded-full px-2.5 text-[9px] font-semibold leading-none transition hover:-translate-y-0.5 ${
              isActive
                ? "bg-blue-600 text-white shadow-md shadow-blue-600/20"
                : "bg-white text-slate-600 hover:text-blue-600"
            }`}
          >
            {option}
          </button>
        );
      })}
    </div>
  );
}

function EmployerCategoryPills({
  activeCategory,
  onChange,
}: {
  activeCategory: string;
  onChange: (category: string) => void;
}) {
  const categoryTabs = [
    { label: "For You", icon: Sparkles },
    { label: "Saved", icon: Heart },
    { label: "Graphic Design", icon: Sparkles },
    { label: "Photography", icon: Sparkles },
    { label: "Animation", icon: Sparkles },
  ];

  return (
    <div className="mt-2.5 flex flex-wrap justify-center gap-1.5">
      {categoryTabs.map((tab) => {
