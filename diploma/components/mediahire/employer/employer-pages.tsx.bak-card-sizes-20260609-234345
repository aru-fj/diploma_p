function filterCandidatesFromList(
  sourceCandidates: EmployerCandidate[],
  query: string,
  city: string,
  category: string,
  saved: string[],
) {
  return sourceCandidates.filter((candidate) => {
    const search = `${candidate.name} ${candidate.role} ${candidate.category} ${candidate.city} ${candidate.skills.join(" ")}`.toLowerCase();
    const matchesSearch = search.includes(query.toLowerCase());
    const matchesCity = !city || candidate.city.toLowerCase().includes(city.toLowerCase());

    const normalizedCandidateCategory =
      candidate.category === "3D Animation" || candidate.category === "3D / Animation"
        ? "Animation"
        : candidate.category;

    const matchesCategory =
      category === "For You" ||
      (category === "Saved" && saved.includes(candidate.id)) ||
      normalizedCandidateCategory === category ||
      candidate.role.includes(category);

    return matchesSearch && matchesCity && matchesCategory;
  });
}

function filterProjects(query: string, category: string, saved: string[]) {
  return employerProjects.filter((project) => {
    const search = `${project.title} ${project.authorName} ${project.category}`.toLowerCase();
    const matchesSearch = search.includes(query.toLowerCase());

    const normalizedProjectCategory =
      project.category === "3D Animation" || project.category === "3D / Animation"
        ? "Animation"
        : project.category;

    const matchesCategory =
      category === "For You" ||
      (category === "Saved" && saved.includes(project.id)) ||
      normalizedProjectCategory === category;

    return matchesSearch && matchesCategory;
  });
}


