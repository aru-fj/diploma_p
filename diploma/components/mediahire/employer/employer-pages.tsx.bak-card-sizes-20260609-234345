function getEmployerProjectCommentsKey(projectId: string) {
  return `mediahire_employer_project_detail_comments_${projectId}`;
}

function formatEmployerCommentDate() {
  return new Date().toLocaleDateString("en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function getEmployerCommentAuthor() {
  const profile = getEmployerProfile();

  return {
    avatar: profile.avatar || "",
    name:
      profile.companyName ||
      [profile.firstName, profile.lastName].filter(Boolean).join(" ") ||
      profile.email?.split("@")[0] ||
      "Employer",
  };
}

function isCurrentEmployerComment(comment: Partial<EmployerDetailComment>) {
  return comment.isCurrentUser || comment.name === "Employer";
}

function normalizeEmployerProjectDetailComments(
  comments: unknown,
  author: ReturnType<typeof getEmployerCommentAuthor>,
): EmployerDetailComment[] {
  if (!Array.isArray(comments)) return [];

  return comments
    .filter((item): item is Partial<EmployerDetailComment> & { text: string } => {
      return Boolean(item && typeof item === "object" && "text" in item);
    })
    .map((item, index) => {
      const isCurrent = isCurrentEmployerComment(item);

      return {
        id: item.id || `employer-comment-${index}`,
        name: isCurrent ? author.name : item.name || "Employer",
        avatar: isCurrent ? author.avatar : item.avatar || "",
        date: item.date || formatEmployerCommentDate(),
        text: item.text,
        isCurrentUser: true,
      };
    });
}

function readEmployerProjectDetailComments(
  projectId: string,
  author: ReturnType<typeof getEmployerCommentAuthor>,
): EmployerDetailComment[] {
  if (typeof window === "undefined") return [];

  try {
    const stored = window.localStorage.getItem(getEmployerProjectCommentsKey(projectId));

    if (!stored) return [];

    return normalizeEmployerProjectDetailComments(JSON.parse(stored), author);
  } catch {
    return [];
  }
}

function saveEmployerProjectDetailComments(
  projectId: string,
  comments: EmployerDetailComment[],
) {
  if (typeof window === "undefined") return;

  window.localStorage.setItem(
    getEmployerProjectCommentsKey(projectId),
    JSON.stringify(comments),
  );
}


