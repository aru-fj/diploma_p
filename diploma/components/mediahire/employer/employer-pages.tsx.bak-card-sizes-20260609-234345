type EmployerCommunityContact = {
  avatar: string;
  bio: string;
  id: string;
  name: string;
  role: string;
};

const employerCommunityStorageKey = "mediahire_employer_community_chats";

function formatEmployerCommunityMessageTime() {
  return new Intl.DateTimeFormat("en", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(new Date());
}

function getEmployerCommunityInitials(name: string) {
  return name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

const employerMediaHireConversation: Conversation = {
  color: "bg-[#0B63E5] text-white",
  id: "mediahire",
  initials: "M",
  lastSeen: "MediaHire Support",
  messages: [
    {
      id: "mediahire-welcome-1",
      sender: "contact",
      text: "Welcome to MediaHire. We are here to help you with candidates, messages, saved profiles, and platform questions.",
      time: "Now",
      type: "text",
    },
  ],
  name: "MediaHire",
  participantType: "system",
  preview: "Welcome to MediaHire.",
  time: "Now",
  unread: 1,
};

function normalizeEmployerCommunityChatId(chatId: string | null) {
  if (!chatId || chatId === "mediahire-welcome") {
    return "mediahire";
  }

  return chatId;
}

function toEmployerCommunitySlug(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function createEmployerConversationFromId(chatId: string): Conversation | null {
  if (chatId === "mediahire") {
    return employerMediaHireConversation;
  }

  const normalizedChatId = toEmployerCommunitySlug(chatId);

  const candidate = employerCandidates.find((item) => {
    return (
      item.id === chatId ||
      item.id === normalizedChatId ||
      toEmployerCommunitySlug(item.id) === normalizedChatId ||
      toEmployerCommunitySlug(item.name) === normalizedChatId
    );
  });

  if (candidate) {
    return {
      avatar: candidate.avatar,
      color: "bg-blue-50 text-blue-700",
      id: chatId,
      initials: getEmployerCommunityInitials(candidate.name),
      lastSeen: "Online",
      messages: [],
      name: candidate.name,
      participantType: "person",
      preview: "Start the conversation.",
      profileHref: `/home/employer/people/${candidate.id}`,
      time: "Now",
      unread: 0,
    };
  }

  const fallbackName = chatId
    .split("-")
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");

  return {
    color: "bg-blue-50 text-blue-700",
    id: chatId,
    initials: getEmployerCommunityInitials(fallbackName || "Candidate"),
    lastSeen: "Online",
    messages: [],
    name: fallbackName || "Candidate",
    participantType: "person",
    preview: "Start the conversation.",
    profileHref: `/home/employer/people/${chatId}`,
    time: "Now",
    unread: 0,
  };
}

function getEmployerPersistableConversations(conversations: Conversation[]) {
  const conversationsById = new Map<string, Conversation>();

  conversations.forEach((conversation) => {
    if (conversation.id === "mediahire" || conversation.messages.length > 0) {
      conversationsById.set(conversation.id, conversation);
    }
  });

  if (!conversationsById.has("mediahire")) {
    conversationsById.set("mediahire", employerMediaHireConversation);
  }

  return Array.from(conversationsById.values());
}

function sortEmployerCommunityConversations(conversations: Conversation[]) {
  return [...conversations].sort((firstConversation, secondConversation) => {
    if (firstConversation.id === "mediahire") return -1;
    if (secondConversation.id === "mediahire") return 1;

    const starredDifference =
      Number(Boolean(secondConversation.starred)) -
      Number(Boolean(firstConversation.starred));

    if (starredDifference !== 0) {
      return starredDifference;
    }

    return 0;
  });
}

function persistEmployerCommunityConversations(conversations: Conversation[]) {
  if (typeof window === "undefined") {
    return;
  }

  window.localStorage.setItem(
    employerCommunityStorageKey,
    JSON.stringify(getEmployerPersistableConversations(conversations)),
  );
}

function readEmployerCommunityConversations() {
  if (typeof window === "undefined") {
    return [employerMediaHireConversation];
  }

  try {
    const raw = window.localStorage.getItem(employerCommunityStorageKey);
    const parsed = raw ? JSON.parse(raw) : null;

    if (!Array.isArray(parsed)) {
      return [employerMediaHireConversation];
    }

    return getEmployerPersistableConversations(parsed as Conversation[]);
  } catch {
    return [employerMediaHireConversation];
  }
}

function getInitialEmployerCommunityConversations(initialChatId: string | null) {
  const storedConversations = readEmployerCommunityConversations();
  const normalizedChatId = normalizeEmployerCommunityChatId(initialChatId);

  if (
    storedConversations.some(
      (conversation) => conversation.id === normalizedChatId,
    )
  ) {
    return storedConversations;
  }

  const createdConversation = createEmployerConversationFromId(normalizedChatId);

  if (!createdConversation) {
    return storedConversations;
  }

  return [createdConversation, ...storedConversations];
}

export function EmployerCommunityPage({ initialChatId = null }: { initialChatId?: string | null }) {
  const [conversations, setConversations] = useState<Conversation[]>([
    employerMediaHireConversation,
  ]);
  const [query, setQuery] = useState("");
  const [selectedId, setSelectedId] = useState<string | null>("mediahire");

  useEffect(() => {
    const normalizedChatId = normalizeEmployerCommunityChatId(initialChatId);
    const storedConversations = readEmployerCommunityConversations();

    if (initialChatId && normalizedChatId !== "mediahire") {
      const existingConversation = storedConversations.find(
        (conversation) => conversation.id === normalizedChatId,
      );

      const pendingConversation =
        existingConversation || createEmployerConversationFromId(normalizedChatId);

      if (pendingConversation) {
        const nextConversations = [
          ...storedConversations.filter(
            (conversation) => conversation.id === "mediahire",
          ),
          pendingConversation,
          ...storedConversations.filter(
            (conversation) =>
              conversation.id !== "mediahire" &&
              conversation.id !== pendingConversation.id,
          ),
        ];

        setConversations(nextConversations);
        setSelectedId(pendingConversation.id);

        if (typeof window !== "undefined") {
          window.history.replaceState(null, "", "/home/employer/community");
        }

        return;
      }
    }

    setConversations(storedConversations);
    setSelectedId("mediahire");
  }, [initialChatId]);

  const sidebarConversations = useMemo(() => {
    return conversations.filter(
      (conversation) =>
        conversation.id === "mediahire" ||
        conversation.messages.length > 0 ||
        conversation.id === selectedId,
    );
  }, [conversations, selectedId]);

  const filteredConversations = useMemo(() => {
    const normalizedQuery = query.trim().toLowerCase();

    if (!normalizedQuery) {
      return sortEmployerCommunityConversations(sidebarConversations);
    }

    return sortEmployerCommunityConversations(
      sidebarConversations.filter((conversation) =>
        `${conversation.name} ${conversation.preview}`
          .toLowerCase()
          .includes(normalizedQuery),
      ),
    );
  }, [query, sidebarConversations]);

  const selectedConversation =
    conversations.find((conversation) => conversation.id === selectedId) ??
    null;

  function handleSelect(conversationId: string) {
    setSelectedId(conversationId);

    setConversations((currentConversations) => {
      const nextConversations = currentConversations.map((conversation) =>
        conversation.id === conversationId
          ? { ...conversation, unread: 0 }
          : conversation,
      );

      persistEmployerCommunityConversations(nextConversations);
      return nextConversations;
    });
  }

  function handleSend(message: string) {
    const trimmedMessage = message.trim();

    if (!trimmedMessage || !selectedId) {
      return;
    }

    setConversations((currentConversations) => {
      const existingConversation =
        currentConversations.find(
          (conversation) => conversation.id === selectedId,
        ) || createEmployerConversationFromId(selectedId);

      if (!existingConversation) {
        return currentConversations;
      }

      const updatedConversation: Conversation = {
        ...existingConversation,
        messages: [
          ...existingConversation.messages.filter(
            (item) => !item.id.endsWith("-pending-start"),
          ),
          {
            id: `${existingConversation.id}-${Date.now()}`,
            sender: "me",
            text: trimmedMessage,
            time: formatEmployerCommunityMessageTime(),
            type: "text",
          } satisfies ChatMessage,
        ],
        preview: trimmedMessage,
        time: "Now",
        unread: 0,
      };

      const nextConversations = [
        updatedConversation,
        ...currentConversations.filter(
          (conversation) => conversation.id !== updatedConversation.id,
        ),
      ];

      const nextPersisted =
        getEmployerPersistableConversations(nextConversations);

      persistEmployerCommunityConversations(nextPersisted);
      setSelectedId(updatedConversation.id);
      return nextPersisted;
    });
  }

  function handleToggleStar(conversationId: string) {
    setConversations((currentConversations) => {
      const nextConversations = currentConversations.map((conversation) =>
        conversation.id === conversationId
          ? { ...conversation, starred: !conversation.starred }
          : conversation,
      );

      persistEmployerCommunityConversations(nextConversations);
      return nextConversations;
    });
  }

  return (
    <EmployerShell active="Community">
      <motion.section
        animate="show"
        className="mx-auto w-[min(1152px,calc(100%-32px))] px-0 pb-20 pt-8"
        initial="hidden"
        transition={mediaHireMotion.page}
        variants={fadeIn}
      >
        <section>
          <h1 className="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
            Message
          </h1>

          <p className="mt-2 text-sm font-medium text-slate-500">
            Communicate with candidates and stay updated on hiring conversations
          </p>
        </section>

        <section className="mt-4 grid gap-4 lg:h-[500px] lg:grid-cols-[470px_1fr]">
          <div className={selectedConversation ? "hidden lg:block" : "block"}>
            <ChatSidebar
              conversations={filteredConversations}
              onQueryChange={setQuery}
              onSelect={handleSelect}
              query={query}
              selectedId={selectedId}
            />
          </div>

          <div className={selectedConversation ? "block" : "hidden lg:block"}>
            {selectedConversation ? (
              <ChatWindow
                conversation={selectedConversation}
                onBack={() => setSelectedId(null)}
                onSend={handleSend}
                onToggleStar={handleToggleStar}
              />
            ) : (
              <EmptyChatState />
            )}
          </div>
        </section>
      </motion.section>
    </EmployerShell>
  );
}


