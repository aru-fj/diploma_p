import { supabase } from "@/lib/supabase-client";
import type { PublicWork, PublicWorkMedia } from "./public-works-data";

const fallbackCover =
  "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=90";

type ProjectRow = {
  id: string;
  title: string;
  description?: string | null;
  status: string;
  cover_url?: string | null;
  created_at?: string | null;
  updated_at?: string | null;
  published_at?: string | null;
  author_id: string;
};

type MediaRow = {
  id: string;
  project_id: string;
  type: string;
  url?: string | null;
  text_content?: string | null;
  file_name?: string | null;
  order_index?: number | null;
};

type ProfileRow = {
  id: string;
  user_id?: string | null;
  full_name?: string | null;
  first_name?: string | null;
  last_name?: string | null;
  email?: string | null;
  avatar_url?: string | null;
  public_slug?: string | null;
  profile_visibility?: boolean | null;
  public_portfolio?: boolean | null;
  profession?: string | null;
  job_title?: string | null;
  location?: string | null;
  city?: string | null;
  country?: string | null;
};

function formatDate(value?: string | null) {
  if (!value) return "Recently added";

  try {
    return new Intl.DateTimeFormat("en", {
      month: "long",
      year: "numeric",
    }).format(new Date(value));
  } catch {
    return "Recently added";
  }
}

function profileName(profile?: ProfileRow) {
  return (
    profile?.full_name ||
    [profile?.first_name, profile?.last_name].filter(Boolean).join(" ") ||
    profile?.email?.split("@")[0] ||
    "MediaHire creator"
  );
}

function profileRole(profile?: ProfileRow) {
  return profile?.profession || profile?.job_title || "Creative specialist";
}

function profileLocation(profile?: ProfileRow) {
  return (
    profile?.location ||
    [profile?.city, profile?.country].filter(Boolean).join(", ") ||
    "Kazakhstan"
  );
}

function mediaToGallery(mediaRows: MediaRow[], project: ProjectRow): PublicWorkMedia[] {
  const gallery = mediaRows
    .slice()
    .sort((a, b) => (a.order_index ?? 0) - (b.order_index ?? 0))
    .map((media): PublicWorkMedia | null => {
      if ((media.type === "image" || media.type === "photo_grid") && media.url) {
        return {
          type: "image",
          src: media.url,
          alt: media.file_name || project.title,
        };
      }

      if (media.type === "video" && media.url) {
        return {
          type: "video",
          src: media.url,
          title: media.file_name || project.title,
        };
      }

      if (media.type === "youtube" && media.url) {
        return {
          type: "youtube",
          src: media.url,
          title: media.file_name || project.title,
        };
      }

      if (media.type === "pdf" && media.url) {
        return {
          type: "pdf",
          src: media.url,
          title: media.file_name || project.title,
        };
      }

      if (media.type === "text" && media.text_content) {
        return {
          type: "text",
          text: media.text_content,
        };
      }

      return null;
    })
    .filter((item): item is PublicWorkMedia => Boolean(item));

  if (gallery.length) {
    return gallery;
  }

  return [
    {
      type: "image",
      src: project.cover_url || fallbackCover,
      alt: project.title,
    },
  ];
}

export async function getRemotePublishedWorks(): Promise<PublicWork[]> {
  const { data: projectRows, error } = await supabase
    .from("projects")
    .select(
      "id,title,description,status,cover_url,created_at,updated_at,published_at,author_id",
    )
    .eq("status", "published")
    .order("published_at", { ascending: true });

  if (error || !projectRows?.length) {
    if (error) {
      console.error("Could not load public projects:", error);
    }

    return [];
  }

  const projects = projectRows as ProjectRow[];
  const projectIds = projects.map((project) => project.id);

  const { data: mediaRows } = projectIds.length
    ? await supabase
        .from("project_media")
        .select("id,project_id,type,url,text_content,file_name,order_index")
        .in("project_id", projectIds)
        .order("order_index", { ascending: true })
    : { data: [] };

  const authorIds = Array.from(
    new Set(projects.map((project) => project.author_id).filter(Boolean)),
  );

  const profileSelect =
    "id,user_id,public_slug,full_name,first_name,last_name,email,avatar_url,profession,job_title,location,city,country,profile_visibility,public_portfolio";

  const byUserId = authorIds.length
    ? await supabase.from("profiles").select(profileSelect).in("user_id", authorIds)
    : { data: [] };

  const foundUserIds = new Set(
    ((byUserId.data || []) as ProfileRow[])
      .map((profile) => profile.user_id)
      .filter(Boolean),
  );

  const missingAuthorIds = authorIds.filter((id) => !foundUserIds.has(id));

  const byId = missingAuthorIds.length
    ? await supabase.from("profiles").select(profileSelect).in("id", missingAuthorIds)
    : { data: [] };

  const profilesById = new Map<string, ProfileRow>();

  [
    ...((byUserId.data || []) as ProfileRow[]),
    ...((byId.data || []) as ProfileRow[]),
  ].forEach((profile) => {
    profilesById.set(profile.id, profile);

    if (profile.user_id) {
      profilesById.set(profile.user_id, profile);
    }
  });

  const mediaByProjectId = new Map<string, MediaRow[]>();

  ((mediaRows || []) as MediaRow[]).forEach((media) => {
    const current = mediaByProjectId.get(media.project_id) || [];
    current.push(media);
    mediaByProjectId.set(media.project_id, current);
  });

  return projects.flatMap((project): PublicWork[] => {
    const profile = profilesById.get(project.author_id);

    if (!profile?.profile_visibility || !profile?.public_portfolio) {
      return [];
    }

    const gallery = mediaToGallery(mediaByProjectId.get(project.id) || [], project);
    const firstImage = gallery.find((item) => item.type === "image");

    return [
      {
        slug: project.id,
        title: project.title,
        author: profileName(profile),
        authorSlug: profile.public_slug || project.author_id,
        role: profileRole(profile),
        company: "MediaHire",
        category: profileRole(profile),
        type: "Project-based",
        location: profileLocation(profile),
        createdAt: formatDate(project.published_at || project.created_at),
        coverImage:
          project.cover_url ||
          (firstImage?.type === "image" ? firstImage.src : undefined) ||
          fallbackCover,
        authorAvatar: profile.avatar_url || undefined,
        gallery,
        description: project.description || "",
        responsibilities: ["Portfolio project", "Creative work", "Media production"],
        tools: ["MediaHire"],
      },
    ];
  });
}

export async function getRemotePublishedWorkBySlug(slug: string) {
  const works = await getRemotePublishedWorks();

  return works.find((work) => work.slug === slug);
}
